# Application
NEXT_PUBLIC_DOMAIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
MONGO_URI=

# Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL_INTERNAL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_ENCRYPTION_KEY=
PLATFORM_OWNER_EMAILS=
AUDIT_IP_HASH_SALT=
CRON_SECRET=
# Optional delivery adapter used for verification, password-reset, magic-link and login-alert email.
AUTH_EMAIL_DELIVERY_URL=
AUTH_EMAIL_DELIVERY_TOKEN=

# Location search (maps use OpenFreeMap and need no token)
# Restrict this browser key to your localhost and production domains in Geoapify.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
# Optional server-only key. If omitted, the public key is also used by API routes.
GEOAPIFY_API_KEY=

# Optional AI listing evidence. AI never publishes or rejects a listing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DOCUMENT_MODEL=gemini-2.5-flash

# Optional encrypted Web Push delivery. Generate one VAPID key pair for the deployment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example
NOTIFICATION_DELIVERY_URL=
NOTIFICATION_DELIVERY_TOKEN=

# Media
CLOUDINERY_CLOUD_NAME=
CLOUDINERY_API_KEY=
CLOUDINERY_API_SECRET=

# Payments (Stripe Global Checkout)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayFast (Optional Regional fallback for ZAR)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_RETURN_URL=http://localhost:3000/payment/success
PAYFAST_CANCEL_URL=http://localhost:3000/payment/cancel
PAYFAST_NOTIFY_URL=https://your-public-domain.example/api/payment/notify
PAYFAST_URL=https://sandbox.payfast.co.za/eng/process

