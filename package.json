    "mongodb": "^6.18.0",
    "mongoose": "^8.17.1",
    "next": "16.3.0",
    "next-auth": "^4.24.11",
    "photoswipe": "^5.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.7.0",
    "react-map-gl": "^8.1.2",
    "react-photoswipe-gallery": "^3.1.1",
    "react-share": "^5.2.2",
    "react-spinners": "^0.17.0",
