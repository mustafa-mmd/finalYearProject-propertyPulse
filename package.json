{
  "name": "property",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --require ./config/dns-preload.cjs ./node_modules/next/dist/bin/next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "migrate:locations": "node --require ./config/dns-preload.cjs --env-file=.env.local scripts/migrate-property-locations.mjs",
    "test:locations": "node scripts/test-location-structure.mjs",
    "test:payments": "node scripts/test-payment-security.mjs",
    "test:domain": "node scripts/test-domain-structure.mjs",
    "test:roadmap": "node scripts/test-roadmap-coverage.mjs",
    "test:i18n": "node scripts/test-i18n-coverage.mjs",
    "test:mobile": "node mobile/scripts/validate-mobile.mjs",
    "test:enterprise": "node scripts/test-enterprise-security.mjs",
    "test:auth": "node scripts/test-auth-security.mjs",
    "test:completion": "node scripts/test-completion-workflows.mjs",
    "test:admin": "node scripts/test-admin-security.mjs",
    "test": "npm run test:locations && npm run test:payments && npm run test:domain && npm run test:roadmap && npm run test:i18n && npm run test:mobile && npm run test:enterprise && npm run test:auth && npm run test:admin && npm run test:completion",
    "verify:locations": "node --require ./config/dns-preload.cjs --env-file=.env.local scripts/verify-location-providers.mjs",
    "check:env": "node --env-file=.env.local scripts/check-environment.mjs",
    "migrate:commercial": "node --require ./config/dns-preload.cjs --env-file=.env.local scripts/migrate-commercial-foundation.mjs",
    "migrate:commercial:apply": "node --require ./config/dns-preload.cjs --env-file=.env.local scripts/migrate-commercial-foundation.mjs --apply"
